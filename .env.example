# Optional local Ollama configuration. The app does not load or commit .env files automatically.
# Export these variables in your shell before starting Streamlit.
OPPORTUNITYKIT_OLLAMA_URL=http://127.0.0.1:11434
OPPORTUNITYKIT_MODEL=gemma4:e4b
OPPORTUNITYKIT_OLLAMA_TIMEOUT=60

# Optional external providers. External AI is disabled by default in the app.
# Configure a model identifier before enabling external AI in About → AI Settings.
OPPORTUNITYKIT_ENABLE_EXTERNAL_AI=false
OPPORTUNITYKIT_OPENROUTER_ENABLED=false
OPPORTUNITYKIT_OPENROUTER_MODEL=
OPENROUTER_API_KEY=
OPPORTUNITYKIT_GEMINI_ENABLED=false
OPPORTUNITYKIT_GEMINI_MODEL=
GEMINI_API_KEY=
OPPORTUNITYKIT_GROK_ENABLED=false
OPPORTUNITYKIT_GROK_MODEL=
XAI_API_KEY=

# Optional provider order and bounded timeout/attempt controls.
OPPORTUNITYKIT_AI_PRIORITY=ollama,openrouter,gemini,grok,fallback
OPPORTUNITYKIT_AI_TIMEOUT=30
OPPORTUNITYKIT_AI_MAX_ATTEMPTS=4
